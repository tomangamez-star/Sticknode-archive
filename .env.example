TELEGRAM_TOKEN=
DATABASE_URL=
ARCHIVE_CHAT_ID=
OWNER_ID=
INGEST_NOTIFICATION_CHAT_ID=
PORT=10000
NODE_ENV=production

STICKNODES_BASE_URL=https://sticknodes.com
STICKNODES_LIST_URL=https://sticknodes.com/stickfigures/
SCRAPER_AUTO_RUN=false
SCRAPER_INTERVAL_MINUTES=10
SCRAPER_BACKFILL_PAGES_PER_CYCLE=0
SCRAPER_RECENT_PAGES=3
SCRAPER_SITE_DELAY_MS=350
SCRAPER_UPLOAD_DELAY_MS=1100
SCRAPER_MAX_FILE_MB=45
SCRAPER_FETCH_DETAILS=true
SCRAPER_PROVIDER_RETRIES=2
SCRAPER_PROVIDER_RETRY_DELAY_SECONDS=5

# Fetch pipeline: archive -> mini retriever -> provider
INGEST_FETCH_PROVIDER=retriever
RETRIEVER_PROVIDER=direct
RETRIEVER_ALLOWED_HOSTS=sticknodes.com
RETRIEVER_RESPECT_ROBOTS=true
RETRIEVER_TIMEOUT_SECONDS=60

# Optional external retrieval provider. Keep this secret.
SCRAPERAPI_KEY=
SCRAPERAPI_ENDPOINT=https://api.scraperapi.com/
ARCHIVE_PAGE_SIZE=20
INGEST_API_SECRET=change-me-to-a-long-random-secret
